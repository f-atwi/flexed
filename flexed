[ "$_flexed_loaded" ] && return 0
_flexed_loaded=1

[ "$_hivecore_loaded" ] || {
    echo "flexed: hivecore plugin not loaded — run: hive add hivecore" >&2
    return 1
}

flylxsh()  { _fly_transport_run lxc "$@"; }
flxsh()    { flylxsh "$@"; }
flylxshb() { _fly_destshell=bash flylxsh "$@"; }
flxshb()   { flylxshb "$@"; }
flylxshz() { _fly_destshell=zsh  flylxsh "$@"; }
flxshz()   { flylxshz "$@"; }
flylxshk() { _fly_destshell=ksh  flylxsh "$@"; }
flxshk()   { flylxshk "$@"; }
