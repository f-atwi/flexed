[ "$_flexed_loaded" ] && return 0
_flexed_loaded=1

[ "$_hive-core_loaded" ] || {
    echo "flexed: hive-core plugin not loaded — run: fly add f-atwi/hive-core" >&2
    return 1
}

flylxsh()  { _fly_transport_run lxc "$@"; }
flxsh()    { flylxsh "$@"; }
flylxshb() { _fly_destshell=bash flylxsh "$@"; }
flxshb()   { flylxshb "$@"; }
flylxshz() { _fly_destshell=zsh  flylxsh "$@"; }
flxshz()   { flylxshz "$@"; }
flylxshk() { _fly_destshell=ksh  flylxsh "$@"; }
flxshk()   { flylxshk "$@"; }
