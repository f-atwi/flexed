[ "$_flexed_loaded" ] && return 0
_flexed_loaded=1

[ "$_flugcore_loaded" ] || { _flug_core="${FLY_HOME:-$HOME}/.fly.d/plugins/flug-core/flug-core"; [ -f "$_flug_core" ] && . "$_flug_core" || { echo "flexed: flug-core plugin not installed — run: fly add f-atwi/flug-core" >&2; return 1; }; unset _flug_core; }

flylxcshell() { _fly_transport_run lxc "$@"; }
flxcshell()  { flylxcshell "$@"; }
flylxcbash() { _fly_destshell=bash flylxcshell "$@"; }
flxcbash()   { flylxcbash "$@"; }
flylxczsh()  { _fly_destshell=zsh  flylxcshell "$@"; }
flxczsh()    { flylxczsh "$@"; }
flylxcksh()  { _fly_destshell=ksh  flylxcshell "$@"; }
flxcksh()    { flylxcksh "$@"; }
